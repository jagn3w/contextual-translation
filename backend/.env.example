# Copy to .env for local development. Production sets these as CapRover app env vars (design D5.3).

# Postgres: the dev container runs it on TCP only.
PGHOST=127.0.0.1

# Translation backend: "fake" (deterministic, no network) or "claude" (design D2.4).
TRANSLATOR=fake

# How the Claude client authenticates when TRANSLATOR=claude (design D5.2):
#   api_key — local development and the eval set; set ANTHROPIC_API_KEY (a *dev* workspace key)
#   wif     — production: Workload Identity Federation via the EC2 instance role
CLAUDE_AUTH=api_key
ANTHROPIC_API_KEY=

# Model and effort (design D2.2). Defaults: claude-opus-5, medium.
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=medium

# Production (CLAUDE_AUTH=wif) also needs these identifiers — not secrets (design D5.2):
# AWS_REGION=us-east-1
# ANTHROPIC_FEDERATION_RULE_ID=
# ANTHROPIC_ORGANIZATION_ID=
# ANTHROPIC_SERVICE_ACCOUNT_ID=
# ANTHROPIC_WORKSPACE_ID=

# HMAC key for access-code digests (design D4.1). Development/test have a built-in default;
# production requires a real value: openssl rand -hex 32
# ACCESS_CODE_PEPPER=

# Host the app is served from; the Origin check compares against it (design D4.2).
APP_HOST=localhost:5173
