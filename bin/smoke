#!/usr/bin/env bash
# End-to-end API check with curl, the way the browser talks to the backend: cookie session,
# JSON bodies and the app's Origin header (design D4.2).
#
#   bin/smoke ACCESS_CODE [BASE_URL]
#
# BASE_URL defaults to http://localhost:5173 (the Vite dev server, which proxies to Rails).
# Against Rails directly on :3000 in development, set ORIGIN=http://localhost:5173 — the origin
# Rails expects. TEXT, CONTEXT, FROM and TO override the sample translation.
set -euo pipefail

code=${1:?usage: bin/smoke ACCESS_CODE [BASE_URL]}
base=${2:-${BASE_URL:-http://localhost:5173}}
base=${base%/}
origin=${ORIGIN:-$(sed -E 's#^(https?://[^/]+).*#\1#' <<<"$base")}
text=${TEXT:-Is this a bat?}
context=${CONTEXT:-At a baseball game, pointing at the equipment by the dugout.}
from=${FROM:-EN}
to=${TO:-ES}

command -v jq >/dev/null || { echo "bin/smoke needs jq" >&2; exit 2; }
jar=$(mktemp)
out=$(mktemp)
trap 'rm -f "$jar" "$out"' EXIT

# request METHOD PATH [JSON] -> prints the HTTP status; the body is left in $out
request() {
  local args=(-sS -o "$out" -w '%{http_code}' -X "$1" -b "$jar" -c "$jar"
    -H "Origin: $origin" -H "Content-Type: application/json" -H "Accept: application/json")
  [[ $# -ge 3 ]] && args+=(--data "$3")
  curl "${args[@]}" "$base$2"
}

graphql() { # QUERY [VARIABLES_JSON]
  request POST /graphql "$(jq -nc --arg q "$1" --argjson v "${2:-{\}}" '{query: $q, variables: $v}')"
}

expect() { # STEP EXPECTED_STATUS ACTUAL_STATUS
  if [[ "$3" == "$2" ]]; then
    printf '  ok    %-28s %s\n' "$1" "$3"
  else
    printf '  FAIL  %-28s expected %s, got %s: %s\n' "$1" "$2" "$3" "$(head -c 300 "$out")"
    exit 1
  fi
}

echo "Smoke-testing $base (Origin: $origin)"

expect "health check" 200 "$(curl -sS -o "$out" -w '%{http_code}' "$base/up")"
expect "sign in" 204 "$(request POST /api/session "$(jq -nc --arg c "$code" '{code: $c}')")"

expect "viewer query" 200 "$(graphql '{ viewer { accessCodeLabel sessionExpiresAt } }')"
jq -r '"        signed in as \(.data.viewer.accessCodeLabel), session until \(.data.viewer.sessionExpiresAt)"' "$out"

variables=$(jq -nc --arg t "$text" --arg c "$context" --arg f "$from" --arg to "$to" \
  '{input: {sourceText: $t, context: $c, sourceLanguage: $f, targetLanguage: $to}}')
expect "translate" 200 "$(graphql 'mutation($input: TranslateInput!) {
  translate(input: $input) { translation { text notes } errors { code message retryable } } }' "$variables")"
if [[ "$(jq '.data.translate.errors | length' "$out")" != "0" ]]; then
  echo "  FAIL  translate returned errors:"; jq '.data.translate.errors' "$out"; exit 1
fi
jq -r '"        \(.data.translate.translation.text)", "        notes: \(.data.translate.translation.notes // "—")"' "$out"

expect "sign out" 204 "$(request DELETE /api/session)"
expect "viewer after sign-out" 401 "$(graphql '{ viewer { accessCodeLabel } }')"

echo "All smoke checks passed."
