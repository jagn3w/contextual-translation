#!/usr/bin/env bash
# Runs the whole app locally: Postgres, Rails on :3000 and Vite on :5173. Open
# http://localhost:5173; Ctrl-C stops everything this script started.
#
#   bin/dev
#
# First run: copies backend/.env.example to backend/.env (fake translator, no API key needed),
# installs gems and packages, creates the database, and prints how to make an access code.
#
# Postgres keeps its data in PG_DEV_DIR (default ~/.cache/pg-dev), TCP only (the dev container
# recipe). A Postgres that was already running is left running on exit.
#
# Overrides: RAILS_PORT (3000), VITE_PORT (5173), PGPORT (5432), PG_DEV_DIR.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RAILS_PORT=${RAILS_PORT:-3000}
VITE_PORT=${VITE_PORT:-5173}
PG_DEV_DIR=${PG_DEV_DIR:-$HOME/.cache/pg-dev}
export PGHOST=127.0.0.1
export PGPORT=${PGPORT:-5432}
# Vite proxies /api and /graphql here, and Rails' Origin check expects the Vite origin.
export RAILS_URL="http://127.0.0.1:$RAILS_PORT"
export APP_HOST="localhost:$VITE_PORT"

say() { printf '\033[1m[dev]\033[0m %s\n' "$*"; }

for tool in bundle pnpm initdb pg_ctl curl; do
  command -v "$tool" >/dev/null || { echo "bin/dev: $tool is not on PATH" >&2; exit 1; }
done

pids=()
started_pg=false
cleanup() {
  trap - EXIT INT TERM
  set +e # the servers exit non-zero when stopped; keep going so Postgres is stopped too
  if ((${#pids[@]})); then
    kill "${pids[@]}" 2>/dev/null
    wait "${pids[@]}" 2>/dev/null
  fi
  if $started_pg; then
    say "stopping Postgres"
    pg_ctl -D "$PG_DEV_DIR" -m fast stop >/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# --- Postgres ---------------------------------------------------------------------------------
if [[ ! -f "$PG_DEV_DIR/PG_VERSION" ]]; then
  say "creating a Postgres cluster in $PG_DEV_DIR"
  mkdir -p "$(dirname "$PG_DEV_DIR")"
  initdb -D "$PG_DEV_DIR" --auth=trust >/dev/null
fi
if pg_ctl -D "$PG_DEV_DIR" status >/dev/null 2>&1; then
  say "Postgres already running ($PG_DEV_DIR)"
else
  say "starting Postgres on 127.0.0.1:$PGPORT"
  pg_ctl -D "$PG_DEV_DIR" -l "$PG_DEV_DIR/log" -w \
    -o "-c listen_addresses=127.0.0.1 -c port=$PGPORT -c unix_socket_directories=''" start >/dev/null
  started_pg=true
fi

# --- Backend ----------------------------------------------------------------------------------
cd "$ROOT/backend"
if [[ ! -f .env ]]; then
  cp .env.example .env
  say "created backend/.env from .env.example (TRANSLATOR=fake)"
fi
bundle check >/dev/null 2>&1 || { say "installing gems"; bundle install; }
say "preparing the database"
bin/rails db:prepare >/dev/null
# A pid file left by a server that didn't shut down cleanly makes Rails refuse to start.
if [[ -f tmp/pids/server.pid ]] && ! kill -0 "$(cat tmp/pids/server.pid)" 2>/dev/null; then
  rm -f tmp/pids/server.pid
fi

# --- Frontend ---------------------------------------------------------------------------------
cd "$ROOT/frontend"
[[ -x app/node_modules/.bin/vite ]] || { say "installing packages"; pnpm install --frozen-lockfile; }

# --- Run --------------------------------------------------------------------------------------
# Each server runs directly (exec), so its pid is the one to stop; output is prefixed.
(cd "$ROOT/backend" && exec bin/rails server -b 127.0.0.1 -p "$RAILS_PORT") \
  > >(sed -u 's/^/[rails] /') 2>&1 &
pids+=($!)
# Bind to IPv4: by default Vite listens on [::1] only, which VS Code's port forwarding can't reach.
(cd "$ROOT/frontend/app" && exec ./node_modules/.bin/vite --host 127.0.0.1 --port "$VITE_PORT" --strictPort) \
  > >(sed -u 's/^/[vite]  /') 2>&1 &
pids+=($!)

ready=false
for _ in $(seq 1 60); do
  if curl -fs -o /dev/null "http://127.0.0.1:$RAILS_PORT/up"; then ready=true; break; fi
  kill -0 "${pids[0]}" 2>/dev/null || { say "Rails exited during startup (see [rails] above)"; exit 1; }
  sleep 1
done
$ready || { say "Rails didn't answer /up within 60 s (see [rails] above)"; exit 1; }
say "ready: http://localhost:$VITE_PORT"
say "need an access code? cd backend && bin/rails access_codes:create LABEL=Local"

# Stop everything as soon as either server exits.
wait -n "${pids[@]}" || true
say "a server exited; stopping the other"
